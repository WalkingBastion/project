# Application
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (used by the app container)
DATABASE_URL=postgresql+psycopg2://booking_user:booking_pass@db:5432/booking_db

# Database (used by docker-compose to init the postgres container)
POSTGRES_USER=booking_user
POSTGRES_PASSWORD=booking_pass
POSTGRES_DB=booking_db
