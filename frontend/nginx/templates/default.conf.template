server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Static assets: long-lived cache, filenames are content-hashed by Vite.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Service worker / manifest must always be revalidated so clients pick
    # up updates promptly.
    location ~* \.(?:sw\.js|webmanifest)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Reverse proxy to the backend so the SPA can call same-origin
    # "/api/v1/..." URLs in production, with no CORS setup needed.
    # BACKEND_HOST/BACKEND_PORT are substituted at container start (the
    # official nginx image auto-runs envsubst on *.template files in
    # /etc/nginx/templates/ - see docker-compose.yml for the values).
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: let react-router handle client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
